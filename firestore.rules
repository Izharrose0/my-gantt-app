rules_version = '2';

// Regole di sicurezza Firestore per MY-GANTT.
//
// Tre ruoli:
// - OWNER (`i.coletti@invrsion.com`): legge e scrive tutto, gestisce
//   whitelist accessi.
// - EDITOR (email in /config/auth.editorEmails): legge tutto, modifica
//   task/persone/festivita; NON pu\xf2 modificare la whitelist accessi.
// - VIEWER (email in /config/auth.viewerEmails): sola lettura.
// - Altri: nessun accesso.
//
// L'eliminazione completa del documento workspace e' riservata all'owner
// (gli editor possono solo update via setDoc/updateDoc).
//
// DEPLOY:
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'i.coletti@invrsion.com';
    }

    function authCfg() {
      return get(/databases/$(database)/documents/config/auth).data;
    }

    function editorEmails() {
      let d = authCfg();
      return d.editorEmails is list ? d.editorEmails : [];
    }

    function viewerEmails() {
      let d = authCfg();
      return d.viewerEmails is list ? d.viewerEmails : [];
    }

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isOwner() || request.auth.token.email in editorEmails());
    }

    function isViewer() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && (isEditor() || request.auth.token.email in viewerEmails());
    }

    // Dati del workspace: viewer legge, editor modifica, owner elimina.
    match /workspaces/{doc=**} {
      allow read:           if isViewer();
      allow create, update: if isEditor();
      allow delete:         if isOwner();
    }

    // /config/auth (whitelist viewer+editor): SOLO owner pu\xf2 modificare.
    // Lettura permessa a tutti gli utenti autorizzati cosi' il client puo'
    // determinare il proprio ruolo.
    match /config/auth {
      allow read:  if isViewer();
      allow write: if isOwner();
    }

    // /config/{altri doc} (es. jira projects): editor pu\xf2 modificare.
    match /config/{doc} {
      allow read:  if isViewer();
      allow write: if isEditor();
    }
  }
}
