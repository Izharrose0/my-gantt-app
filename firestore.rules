rules_version = '2';

// Regole di sicurezza Firestore per MY-GANTT.
// Modello: lettura pubblica, scrittura solo per l'owner via Google Sign-In.
//
// DEPLOY:
//   firebase deploy --only firestore:rules
//
// IMPORTANTE: prima di deployare queste rules, l'owner deve essersi loggato
// con Google almeno una volta usando l'email indicata sotto. Altrimenti
// l'app diventa read-only per tutti finché non risolviamo.

service cloud.firestore {
  match /databases/{database}/documents {

    // Workspace condiviso: lettura libera, scrittura solo per l'owner.
    match /{collection}/{doc} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == 'i.coletti@invrsion.com'
                   && request.auth.token.email_verified == true;
    }
  }
}
